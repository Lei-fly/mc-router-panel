# ============================================================
# mc-router + Web 面板 部署 —— 环境变量
# ------------------------------------------------------------
# 用法：cp .env.example .env  然后按需修改
# .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================

# ===== Web 面板（机密）=====
# 面板对外监听端口（浏览器访问 http://宿主:PANEL_PORT）
PANEL_PORT=8080

# 面板登录密码 —— 务必改成强密码
PANEL_PASSWORD=请改成强密码

# ===== mc-router 游戏入口 =====
# Minecraft 客户端连接端口（公网入口）
ROUTER_PORT=25565

# ===== PROXY protocol 全局透传开关 =====
# 默认关闭。开启后 mc-router 会对【所有】后端连接插入 PROXY v2 头，
# 用于把玩家真实公网 IP 透传给后端服务器。
#
# ⚠️ 重要：这是全局开关，一经开启，所有后端都必须同步开启 PROXY protocol 解析，
#    否则玩家将无法连接（后端会把 PROXY 头误判为 Minecraft 协议数据）。
#    - 原版：不支持 PROXY protocol，需改用 Paper 或在前端加 Velocity/BungeeCord
#    - Paper：config/paper-global.yml 设 proxies.proxy-protocol=true
#    - Velocity：velocity.toml 设 [advanced] haproxy-protocol=true
#    - 单服部署且不需要按 IP 封禁/统计时，保持 false 即可。
USE_PROXY_PROTOCOL=false
